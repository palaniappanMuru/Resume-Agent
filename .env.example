# Default LLM provider/model, used as a fallback for JD_LLM_* / CV_LLM_* below: "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: separate LLM for JD extraction vs CV (resume) construction.
# Leave unset to reuse LLM_PROVIDER/LLM_MODEL for both stages.
JD_LLM_PROVIDER=
JD_LLM_MODEL=
CV_LLM_PROVIDER=
CV_LLM_MODEL=

# Minimum overall ATS score (0-100) required before a resume is generated.
ATS_MIN_SCORE_THRESHOLD=60

# Neo4j (Aura: username is almost always "neo4j", not the instance ID)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Candidate profile (graph has no Contact node)
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=
CANDIDATE_LINKEDIN=
